/* Global Cyberpunk Styles - Refresh 2.0 */

QMainWindow {
    background: transparent;
}

QWidget#CentralWidget {
    background-color: rgba(18, 18, 18, 235); /* Off Black, Glassy */
    border: 1px solid #FFD700; /* Dark Yellow Border */
    border-radius: 15px;
}

QLabel {
    color: #E0E0E0;
    font-family: 'Segoe UI';
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #121212;
    width: 6px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #555;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #FFD700;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Tab Widget Styling */
QTabWidget::pane {
    border: none;
    background: transparent;
    padding: 0px;
}

QTabWidget::tab-bar {
    left: 5px; /* move to the right by 5px */
}

QTabBar::tab {
    background: #252525;
    color: #888;
    padding: 8px 12px;
    margin-right: 2px;
    font-weight: bold;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    background: #FFD700; 
    color: #121212;
    border-bottom: 2px solid #FFD700;
}

QTabBar::tab:hover {
    color: #FFD700;
    background: #333;
}

QTabBar::tab:!selected {
    margin-top: 2px; /* make non-selected tabs look smaller */
}

/* Admin Tab Warning Style (Assuming index 4 or specific name? QSS can't target by index easily, relies on general tab) */
/* Tooltip Styling */
QToolTip {
    border: 1px solid #FFD700;
    background-color: #121212;
    color: #FFD700;
    font-family: Consolas;
    padding: 2px;
}

/* ============================================== */
/* NEON BUTTON STYLES - MUST BE VISIBLE ALWAYS   */
/* ============================================== */
QPushButton#NeonButtonWidget {
    background-color: rgba(60, 60, 60, 240);
    color: #FFFFFF;
    border: 2px solid #FFD700;
    border-radius: 4px;
    padding: 4px 8px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 9pt;
    font-weight: 600;
    margin: 2px;
}

QPushButton#NeonButtonWidget:hover {
    color: #FFD700;
    border: 2px solid #FFD700;
    background-color: rgba(80, 80, 80, 250);
}

QPushButton#NeonButtonWidget:pressed {
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    background-color: rgba(100, 100, 100, 255);
}
